{
  "name": "cursor-tg-bot",
  "version": "0.1.0",
  "private": true,
  "description": "Telegram bot for managing Cursor IDE agents across multiple local projects",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/SOLAR8888/cursor-tg-bot.git"
  },
  "bugs": {
    "url": "https://github.com/SOLAR8888/cursor-tg-bot/issues"
  },
  "homepage": "https://github.com/SOLAR8888/cursor-tg-bot#readme",
  "keywords": [
    "cursor",
    "cursor-sdk",
    "telegram",
    "telegram-bot",
    "ai-agent",
    "grammy"
  ],
  "type": "module",
  "engines": {
    "node": ">=20"
  },
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --clear-screen=false --ignore=scripts/** --ignore=data/** --ignore=dist/** src/index.ts",
    "start": "node dist/index.js",
    "serve": "npm run build && node dist/index.js",
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "clean": "rimraf dist",
    "list-agents": "node scripts/list-agents.mjs"
  },
  "dependencies": {
    "@cursor/sdk": "latest",
    "better-sqlite3": "latest",
    "dotenv": "latest",
    "grammy": "latest",
    "p-retry": "latest",
    "pino": "latest",
    "pino-pretty": "latest",
    "win-ca": "^3.5.1",
    "zod": "latest"
  },
  "devDependencies": {
    "@types/better-sqlite3": "latest",
    "@types/node": "latest",
    "rimraf": "latest",
    "tsx": "latest",
    "typescript": "latest"
  }
}
