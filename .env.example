# --- Telegram ---
# Get this from @BotFather in Telegram (command /newbot).
TELEGRAM_BOT_TOKEN=

# CSV of allowed Telegram user IDs. Everyone else is silently ignored.
# You can find your own ID via @userinfobot.
ALLOWED_USER_IDS=

# --- Cursor SDK ---
# https://cursor.com/dashboard/integrations -> "Create new API key"
CURSOR_API_KEY=

# --- Default model (Cursor SDK ModelSelection) ---
# Optional. Defaults to the value below (Auto — Cursor picks the model).
# Available model ids can be discovered via `Cursor.models.list()` or in the IDE.
DEFAULT_MODEL_ID=auto

# --- UX ---
# true = stream "thinking" blocks to Telegram. Defaults to false (less noise).
SHOW_THINKING=false

# Debounce (ms) for editing streaming messages.
STREAM_EDIT_DEBOUNCE_MS=900

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info
# true = log message contents (debug only). Defaults to false (privacy).
LOG_MESSAGES=false
