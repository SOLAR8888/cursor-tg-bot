# --- Telegram ---
# Получить у @BotFather в Telegram (команда /newbot).
TELEGRAM_BOT_TOKEN=

# CSV со списком разрешённых Telegram User ID. ВСЕ остальные будут молча игнорироваться.
# Узнать свой ID можно у @userinfobot.
ALLOWED_USER_IDS=

# --- Cursor SDK ---
# https://cursor.com/dashboard/integrations -> "Create new API key"
CURSOR_API_KEY=

# --- Default model (Cursor SDK ModelSelection) ---
# Опционально. По умолчанию используется значение ниже (Opus 4.7 Max Mode).
# id модели можно посмотреть через `Cursor.models.list()` или в IDE.
DEFAULT_MODEL_ID=claude-opus-4-7
DEFAULT_MODEL_PARAMS=thinking=max

# --- UX ---
# true — стримить размышления (thinking) в Telegram. По умолчанию false (меньше шума).
SHOW_THINKING=false

# Дебаунс редактирования стриминговых сообщений в миллисекундах.
STREAM_EDIT_DEBOUNCE_MS=900

# --- Logging ---
# debug | info | warn | error
LOG_LEVEL=info
# true — логировать содержимое сообщений (для дебага). По умолчанию false (приватность).
LOG_MESSAGES=false
